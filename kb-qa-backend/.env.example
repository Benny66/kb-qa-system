# ── 复制此文件为 .env 并填入真实值 ───────────────────────────────────────────
# cp .env.example .env

# JWT 密钥（生产环境请替换为随机字符串，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ── 预置管理员账号（登录凭据的唯一来源，登录页不再展示账号密码）──────────────
# 用户名：默认 admin，可不改
PRESET_ADMIN_USERNAME=admin
# 密码：必填。首次启动会创建该账号；已存在账号则用此密码覆盖（改这里即生效）
PRESET_ADMIN_PASSWORD=change-me

# 智谱 AI 配置
# API Key 获取：https://open.bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# 模型选择：
#   glm-4-flash  —— 免费，速度快，推荐开发使用
#   glm-4-air    —— 性价比高
#   glm-4        —— 效果最强，按量计费
ZHIPUAI_MODEL=glm-4-flash

ZHIPUAI_EMBEDDING_MODEL=embedding-3

# 上传文件存储目录（相对于 app.py 的路径）
UPLOAD_FOLDER=uploads

CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=kb_qa_chunks
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_EMBED_BATCH_SIZE=32

# 检索距离阈值（cosine distance，越小越相关，范围 0~2）。
# 不设置或留空 = 不过滤（默认）。设置后仅保留 distance 小于该值的片段，
# 全部超阈值时返回空上下文，AI 会回答「未找到相关信息」而非编造答案。
# 建议结合所用 embedding 模型校准（embedding-3 可尝试 0.7~0.9）。
# RAG_DISTANCE_THRESHOLD=0.8
